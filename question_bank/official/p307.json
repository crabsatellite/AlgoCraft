  "solutions": [
    {
      "name": "Backtracking",
      "timeComplexity": "O(9^E)",
      "spaceComplexity": "O(E)",
      "description": "Use boolean arrays for rows, columns, and boxes to track used digits. For each empty cell, try digits 1-9; if valid, place it and recurse. Backtrack on failure.",
      "code": "class Solution {\n    private boolean[][] rows = new boolean[9][9];\n    private boolean[][] cols = new boolean[9][9];\n    private boolean[][] boxes = new boolean[9][9];\n    public void solveSudoku(char[][] board) {\n        for (int i = 0; i < 9; i++) {\n            for (int j = 0; j < 9; j++) {\n                if (board[i][j] != '.') {\n                    int d = board[i][j] - '1';\n                    rows[i][d] = cols[j][d] = boxes[i / 3 * 3 + j / 3][d] = true;\n                }\n            }\n        }\n        solve(board, 0, 0);\n    }\n    private boolean solve(char[][] board, int r, int c) {\n        if (r == 9) return true;\n        int nr = c == 8 ? r + 1 : r, nc = c == 8 ? 0 : c + 1;\n        if (board[r][c] != '.') return solve(board, nr, nc);\n        int box = r / 3 * 3 + c / 3;\n        for (int d = 0; d < 9; d++) {\n            if (!rows[r][d] && !cols[c][d] && !boxes[box][d]) {\n                rows[r][d] = cols[c][d] = boxes[box][d] = true;\n                board[r][c] = (char) ('1' + d);\n                if (solve(board, nr, nc)) return true;\n                rows[r][d] = cols[c][d] = boxes[box][d] = false;\n                board[r][c] = '.';\n            }\n        }\n        return false;\n    }\n}",
      "language": "java"
    }
  ],
