%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TB
    ROOT(("root<br/>sum: 0"))
    A1(("a<br/>sum: 0"))
    P1(("p<br/>sum: 0"))
    P2(("p<br/>sum: 3")):::wordEnd
    L1(("l<br/>sum: 3"))
    E1(("e<br/>sum: 3")):::wordEnd

    ROOT --> A1
    A1 --> P1
    P1 --> P2
    P2 --> L1
    L1 --> E1

    classDef wordEnd fill:#4ECDC4,stroke:#fff,color:#000

    style ROOT fill:#FF6B6B,stroke:#fff,color:#fff
    style A1 fill:#45B7D1,stroke:#fff,color:#000
    style P1 fill:#45B7D1,stroke:#fff,color:#000
    style L1 fill:#45B7D1,stroke:#fff,color:#000
