%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TB
    subgraph Init["📥 Initialize: k=3, nums=[4,5,8,2]"]
        H1["Min Heap (size k=3)"]
        HEAP1["[4, 5, 8]<br/>Top=4 (3rd largest)"]
    end
    
    subgraph Add1["➕ add(3): 3 < 4, ignore"]
        HEAP2["[4, 5, 8]<br/>Return: 4"]
    end
    
    subgraph Add2["➕ add(5): 5 > 4, push & pop"]
        HEAP3["[5, 5, 8]<br/>Return: 5"]
    end
    
    subgraph Add3["➕ add(10): 10 > 5, push & pop"]
        HEAP4["[5, 8, 10]<br/>Return: 5"]
    end
    
    subgraph Add4["➕ add(9): 9 > 5, push & pop"]
        HEAP5["[8, 9, 10]<br/>Return: 8"]
    end
    
    Init --> Add1
    Add1 --> Add2
    Add2 --> Add3
    Add3 --> Add4
    
    style H1 fill:#FF6B6B,stroke:#fff,color:#fff
    style HEAP1 fill:#4ECDC4,stroke:#fff,color:#000
    style HEAP2 fill:#45B7D1,stroke:#fff,color:#000
    style HEAP3 fill:#96CEB4,stroke:#fff,color:#000
    style HEAP4 fill:#FFEAA7,stroke:#fff,color:#000
    style HEAP5 fill:#DDA0DD,stroke:#fff,color:#000
