graph TB
    subgraph Structure["📊 Two Heap Structure"]
        MAX["Max Heap (Left Half)<br/>Stores smaller elements<br/>Top = largest of small"]
        MIN["Min Heap (Right Half)<br/>Stores larger elements<br/>Top = smallest of large"]
    end
    
    subgraph Example["📝 Example: [1, 2, 3]"]
        S1["Add 1: MaxHeap=[1]"]
        S2["Add 2: MaxHeap=[1], MinHeap=[2]"]
        S3["Add 3: MaxHeap=[1,2], MinHeap=[3]"]
    end
    
    subgraph Median["🎯 Get Median"]
        M1["Odd count: MaxHeap.top()"]
        M2["Even count: (MaxHeap.top() + MinHeap.top()) / 2"]
    end
    
    MAX -->|"Balance: sizes differ by ≤1"| MIN
    Example --> Median
    
    style MAX fill:#FF6B6B,stroke:#fff,color:#fff
    style MIN fill:#4ECDC4,stroke:#fff,color:#000
    style M1 fill:#96CEB4,stroke:#fff,color:#000
    style M2 fill:#FFEAA7,stroke:#fff,color:#000
