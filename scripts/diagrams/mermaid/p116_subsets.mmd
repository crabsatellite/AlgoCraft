%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TB
    subgraph Tree["🌳 Backtracking Tree: nums = [1,2,3]"]
        ROOT["[]"]
        
        L1["[1]"]
        L2["[2]"]
        L3["[3]"]
        
        L1_2["[1,2]"]
        L1_3["[1,3]"]
        L2_3["[2,3]"]
        
        L1_2_3["[1,2,3]"]
        
        ROOT -->|"include 1"| L1
        ROOT -->|"include 2"| L2
        ROOT -->|"include 3"| L3
        
        L1 -->|"include 2"| L1_2
        L1 -->|"include 3"| L1_3
        L2 -->|"include 3"| L2_3
        
        L1_2 -->|"include 3"| L1_2_3
    end
    
    subgraph Result["📋 Result: 2^n subsets"]
        RES["[], [1], [2], [3],<br/>[1,2], [1,3], [2,3],<br/>[1,2,3]"]
    end
    
    Tree --> Result
    
    style ROOT fill:#FF6B6B,stroke:#fff,color:#fff
    style L1 fill:#4ECDC4,stroke:#fff,color:#000
    style L2 fill:#4ECDC4,stroke:#fff,color:#000
    style L3 fill:#4ECDC4,stroke:#fff,color:#000
    style L1_2 fill:#45B7D1,stroke:#fff,color:#000
    style L1_3 fill:#45B7D1,stroke:#fff,color:#000
    style L2_3 fill:#45B7D1,stroke:#fff,color:#000
    style L1_2_3 fill:#96CEB4,stroke:#fff,color:#000
    style RES fill:#FFEAA7,stroke:#fff,color:#000
