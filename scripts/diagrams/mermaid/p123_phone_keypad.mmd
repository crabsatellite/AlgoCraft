graph LR
    subgraph Phone["📱 Phone Keypad Mapping"]
        direction TB
        K2["2: a b c"]
        K3["3: d e f"]
        K4["4: g h i"]
        K5["5: j k l"]
        K6["6: m n o"]
        K7["7: p q r s"]
        K8["8: t u v"]
        K9["9: w x y z"]
    end

    subgraph Example["digits = '23'"]
        direction TB
        D2["digit 2"] --> L2a["'a'"]
        D2 --> L2b["'b'"]
        D2 --> L2c["'c'"]
        
        D3["digit 3"] --> L3a["'d'"]
        D3 --> L3b["'e'"]
        D3 --> L3c["'f'"]
    end

    subgraph Combinations["Cartesian Product"]
        direction TB
        C1["ad"] 
        C2["ae"]
        C3["af"]
        C4["bd"]
        C5["be"]
        C6["bf"]
        C7["cd"]
        C8["ce"]
        C9["cf"]
    end

    L2a --> C1 & C2 & C3
    L2b --> C4 & C5 & C6
    L2c --> C7 & C8 & C9

    style Phone fill:#e8f4f8,stroke:#0288d1
    style Example fill:#fff3e0,stroke:#f57c00
    style Combinations fill:#e8f5e9,stroke:#388e3c
    style K7 fill:#ffeb3b,stroke:#f57f17
    style K9 fill:#ffeb3b,stroke:#f57f17
