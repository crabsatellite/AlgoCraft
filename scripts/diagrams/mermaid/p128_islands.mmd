graph TB
    subgraph Grid["Number of Islands - DFS Traversal"]
        direction TB
        subgraph Before["Input Grid (3 islands)"]
            R1["1 1 0 0 0"]
            R2["1 1 0 0 0"]
            R3["0 0 1 0 0"]
            R4["0 0 0 1 1"]
        end
        
        subgraph DFS["DFS Process"]
            direction LR
            S1["🔍 Start (0,0)"]
            S2["Visit connected 1s"]
            S3["Mark as visited"]
            S4["Count++"]
            S1 --> S2 --> S3 --> S4
        end
        
        subgraph Islands["Identified Islands"]
            direction TB
            I1["🏝️ Island 1<br/>cells: (0,0)(0,1)(1,0)(1,1)"]
            I2["🏝️ Island 2<br/>cells: (2,2)"]
            I3["🏝️ Island 3<br/>cells: (3,3)(3,4)"]
        end
    end

    Before --> DFS
    DFS --> Islands
    
    style Before fill:#e3f2fd,stroke:#1976d2
    style DFS fill:#fff3e0,stroke:#f57c00
    style Islands fill:#e8f5e9,stroke:#388e3c
    style I1 fill:#4caf50,stroke:#2e7d32,color:#fff
    style I2 fill:#4caf50,stroke:#2e7d32,color:#fff
    style I3 fill:#4caf50,stroke:#2e7d32,color:#fff
