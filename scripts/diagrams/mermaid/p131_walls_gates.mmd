graph TB
    subgraph Problem["Walls and Gates - Multi-source BFS"]
        direction TB
        subgraph Initial["Initial Grid"]
            I1["INF  -1   0  INF"]
            I2["INF  INF INF  -1"]
            I3["INF  -1  INF  -1"]
            I4[" 0   -1  INF INF"]
        end

        subgraph BFS["BFS from Gates (distance 0)"]
            direction LR
