            R2[" 2    2   1  -1"]
            R3[" 1   -1   2  -1"]
            R4[" 0   -1   3   4"]
        end
    end

    Initial --> BFS --> Result

    style Initial fill:#e3f2fd,stroke:#1976d2
    style BFS fill:#fff3e0,stroke:#f57c00
    style Result fill:#e8f5e9,stroke:#388e3c
