graph LR
    subgraph WordLadder["Word Ladder - BFS Shortest Path"]
        direction TB
        
        subgraph Level0["Level 0"]
            HIT["hit"]
        end
        
        subgraph Level1["Level 1"]
            HOT["hot"]
        end
        
        subgraph Level2["Level 2"]
            DOT["dot"]
            LOT["lot"]
        end
        
        subgraph Level3["Level 3"]
            DOG["dog"]
            LOG["log"]
        end
        
        subgraph Level4["Level 4"]
            COG["cog ✅"]
        end
        
        HIT -->|"h→o"| HOT
        HOT -->|"o→d"| DOT
        HOT -->|"h→l"| LOT
        DOT -->|"t→g"| DOG
        LOT -->|"t→g"| LOG
        DOG -->|"d→c"| COG
        LOG -->|"l→c"| COG
    end

    style HIT fill:#2196f3,stroke:#1565c0,color:#fff
    style COG fill:#4caf50,stroke:#2e7d32,color:#fff
    style HOT fill:#ff9800,stroke:#ef6c00,color:#fff
    style DOT fill:#ff9800,stroke:#ef6c00,color:#fff
    style LOT fill:#ff9800,stroke:#ef6c00,color:#fff
    style DOG fill:#ff9800,stroke:#ef6c00,color:#fff
    style LOG fill:#ff9800,stroke:#ef6c00,color:#fff
