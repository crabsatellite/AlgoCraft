graph TB
    subgraph MST["Min Cost to Connect All Points - MST"]
        direction TB
        
        subgraph Points["Points on 2D Plane"]
            P0["(0,0)"]
            P1["(2,2)"]
            P2["(3,10)"]
            P3["(5,2)"]
            P4["(7,0)"]
        end
        
        subgraph Edges["Minimum Spanning Tree Edges"]
            E1["(0,0)-(2,2)<br/>cost: 4"]
            E2["(2,2)-(5,2)<br/>cost: 3"]
            E3["(5,2)-(7,0)<br/>cost: 4"]
            E4["(2,2)-(3,10)<br/>cost: 9"]
        end
        
        subgraph Result["Total Cost"]
            R["4 + 3 + 4 + 9 = 20"]
        end

        P0 ---|4| P1
        P1 ---|3| P3
        P3 ---|4| P4
        P1 ---|9| P2
    end

    style P0 fill:#2196f3,stroke:#1565c0,color:#fff
    style P1 fill:#2196f3,stroke:#1565c0,color:#fff
    style P2 fill:#2196f3,stroke:#1565c0,color:#fff
    style P3 fill:#2196f3,stroke:#1565c0,color:#fff
    style P4 fill:#2196f3,stroke:#1565c0,color:#fff
    style Result fill:#4caf50,stroke:#2e7d32,color:#fff
