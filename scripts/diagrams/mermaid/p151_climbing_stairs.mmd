%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '16px' }}}%%
flowchart TD
    subgraph PROBLEM["🎯 Climbing Stairs: n = 5"]
        direction LR
        S0["🚶 Start"] --> S1["Step 1"]
        S1 --> S2["Step 2"]
        S2 --> S3["Step 3"]
        S3 --> S4["Step 4"]
        S4 --> S5["🏁 Top"]
    end
    
    subgraph DP["📊 Dynamic Programming"]
        direction TB
        D0["dp[0] = 1<br/>1 way to stay"] 
        D1["dp[1] = 1<br/>1 way: +1"]
        D2["dp[2] = 2<br/>+1+1, +2"]
        D3["dp[3] = 3<br/>dp[1]+dp[2]"]
        D4["dp[4] = 5<br/>dp[2]+dp[3]"]
        D5["dp[5] = 8<br/>dp[3]+dp[4]"]
    end
    
    subgraph FORMULA["🔢 Fibonacci Pattern"]
        F1["dp[i] = dp[i-1] + dp[i-2]"]
        F2["From i-1: take 1 step"]
        F3["From i-2: take 2 steps"]
    end
    
    subgraph RESULT["✅ Answer: 8 ways"]
        R1["1+1+1+1+1"]
        R2["1+1+1+2, 1+1+2+1, 1+2+1+1, 2+1+1+1"]
        R3["1+2+2, 2+1+2, 2+2+1"]
    end
    
    PROBLEM --> DP --> FORMULA --> RESULT
    
    style PROBLEM fill:#e3f2fd,stroke:#2196f3,stroke-width:2px
    style DP fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style FORMULA fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style RESULT fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
