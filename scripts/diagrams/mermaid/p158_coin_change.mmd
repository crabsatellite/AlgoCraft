%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '16px' }}}%%
flowchart TD
    subgraph INPUT["🎯 coins = [1,2,5], amount = 11"]
        C1["🪙 1"]
        C2["🪙 2"]
        C5["🪙 5"]
    end
    
    subgraph DP["📊 DP Table: dp[i] = min coins for amount i"]
        direction LR
        D0["dp[0]=0"]
        D1["dp[1]=1"]
        D2["dp[2]=1"]
        D3["dp[3]=2"]
        D4["dp[4]=2"]
        D5["dp[5]=1"]
        D6["dp[6]=2"]
        D7["dp[7]=2"]
        D8["dp[8]=3"]
        D9["dp[9]=3"]
        D10["dp[10]=2"]
        D11["dp[11]=3"]
    end
    
    subgraph TRANSITION["🔄 State Transition"]
        T1["dp[i] = min(dp[i], dp[i-coin] + 1)"]
        T2["For each coin in coins:<br/>if i >= coin: update dp[i]"]
    end
    
    subgraph TRACE["✅ Backtrack: amount = 11"]
        TR1["11 - 5 = 6 → 🪙5"]
        TR2["6 - 5 = 1 → 🪙5"]
        TR3["1 - 1 = 0 → 🪙1"]
        RES["Answer: 3 coins (5+5+1)"]
    end
    
    INPUT --> DP --> TRANSITION --> TRACE
    
    style INPUT fill:#e3f2fd,stroke:#2196f3,stroke-width:2px
    style DP fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style TRANSITION fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style TRACE fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
