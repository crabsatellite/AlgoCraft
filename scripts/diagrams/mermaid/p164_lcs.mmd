%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph example[" text1 = 'abcde', text2 = 'ace' "]
        direction LR
        T1["a"]
        T2["b"]
        T3["c"]
        T4["d"]
        T5["e"]
    end
    
    subgraph text2_arr[" text2 "]
        direction LR
        T2A["a"]
        T2B["c"]
        T2C["e"]
    end
    
    subgraph lcs_result[" LCS = 'ace', Length = 3 "]
        direction LR
        L1["a"]
        L2["c"]
        L3["e"]
    end
    
    T1 -.->|match| T2A
    T3 -.->|match| T2B
    T5 -.->|match| T2C
    
    T2A --> L1
    T2B --> L2
    T2C --> L3
    
    L1 --> L2
    L2 --> L3
    
    style T1 fill:#90EE90,stroke:#228B22,color:#000
    style T2 fill:#333333,stroke:#555555,color:#fff
    style T3 fill:#90EE90,stroke:#228B22,color:#000
    style T4 fill:#333333,stroke:#555555,color:#fff
    style T5 fill:#90EE90,stroke:#228B22,color:#000
    
    style T2A fill:#90EE90,stroke:#228B22,color:#000
    style T2B fill:#90EE90,stroke:#228B22,color:#000
    style T2C fill:#90EE90,stroke:#228B22,color:#000
    
    style L1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style L2 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style L3 fill:#4a9eff,stroke:#2a6ecf,color:#fff
