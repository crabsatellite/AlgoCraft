stateDiagram-v2
    direction LR
    
    [*] --> Rest: Start
    
    Rest --> Hold: Buy
    Hold --> Sold: Sell
    Sold --> Rest: Cooldown
    
    Rest --> Rest: Wait
    Hold --> Hold: Wait
    
    note right of Rest
        No stock held
        Can buy or wait
    end note
    
    note right of Hold
        Holding stock
        Can sell or wait
    end note
    
    note right of Sold
        Just sold
        Must cooldown
    end note
