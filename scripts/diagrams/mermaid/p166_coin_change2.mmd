%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph input[" amount = 5, coins = [1, 2, 5] "]
        C1["🪙 1"]
        C2["🪙 2"]
        C5["🪙 5"]
    end
    
    subgraph ways[" 4 Ways to make 5 "]
        W1["5 = 5"]
        W2["5 = 2 + 2 + 1"]
        W3["5 = 2 + 1 + 1 + 1"]
        W4["5 = 1 + 1 + 1 + 1 + 1"]
    end
    
    C5 --> W1
    C2 --> W2
    C1 --> W2
    C2 --> W3
    C1 --> W3
    C1 --> W4
    
    result["Output: 4 combinations"]
    ways --> result
    
    style C1 fill:#FFD700,stroke:#B8860B,color:#000
    style C2 fill:#C0C0C0,stroke:#808080,color:#000
    style C5 fill:#CD7F32,stroke:#8B4513,color:#fff
    
    style W1 fill:#90EE90,stroke:#228B22,color:#000
    style W2 fill:#90EE90,stroke:#228B22,color:#000
    style W3 fill:#90EE90,stroke:#228B22,color:#000
    style W4 fill:#90EE90,stroke:#228B22,color:#000
    
    style result fill:#4a9eff,stroke:#2a6ecf,color:#fff
