%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph strings[" Input Strings "]
        direction LR
        S1["s1 = 'aabcc'"]
        S2["s2 = 'dbbca'"]
    end
    
    subgraph split[" Split into parts "]
        direction LR
        P1A["aa"]
        P1B["bc"]
        P1C["c"]
        P2A["dbbc"]
        P2B["a"]
    end
    
    subgraph interleave[" Interleaving "]
        I1["aa"]
        I2["dbbc"]
        I3["bc"]
        I4["a"]
        I5["c"]
    end
    
    subgraph result[" s3 = 'aadbbcbcac' ✓ "]
        R["aadbbcbcac"]
    end
    
    S1 --> P1A
    S1 --> P1B
    S1 --> P1C
    S2 --> P2A
    S2 --> P2B
    
    P1A --> I1
    P2A --> I2
    P1B --> I3
    P2B --> I4
    P1C --> I5
    
    I1 --> R
    I2 --> R
    I3 --> R
    I4 --> R
    I5 --> R
    
    style S1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style S2 fill:#FFD700,stroke:#B8860B,color:#000
    
    style P1A fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style P1B fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style P1C fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style P2A fill:#FFD700,stroke:#B8860B,color:#000
    style P2B fill:#FFD700,stroke:#B8860B,color:#000
    
    style I1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style I2 fill:#FFD700,stroke:#B8860B,color:#000
    style I3 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style I4 fill:#FFD700,stroke:#B8860B,color:#000
    style I5 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    
    style R fill:#90EE90,stroke:#228B22,color:#000
