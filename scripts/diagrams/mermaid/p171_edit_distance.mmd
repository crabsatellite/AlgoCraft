%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph example[" word1 = 'horse' → word2 = 'ros' "]
        direction LR
        W1["horse"]
        W2["ros"]
    end
    
    subgraph ops[" 3 Operations "]
        O1["horse → rorse"]
        O2["rorse → rose"]
        O3["rose → ros"]
    end
    
    subgraph labels[" Operation Types "]
        L1["Replace 'h' → 'r'"]
        L2["Delete 'r'"]
        L3["Delete 'e'"]
    end
    
    W1 --> O1
    O1 --> O2
    O2 --> O3
    O3 --> W2
    
    O1 -.-> L1
    O2 -.-> L2
    O3 -.-> L3
    
    result["Edit Distance = 3"]
    W2 --> result
    
    style W1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style W2 fill:#90EE90,stroke:#228B22,color:#000
    
    style O1 fill:#FFD700,stroke:#B8860B,color:#000
    style O2 fill:#FF6B6B,stroke:#CC5555,color:#fff
    style O3 fill:#FF6B6B,stroke:#CC5555,color:#fff
    
    style L1 fill:#9370DB,stroke:#7B68EE,color:#fff
    style L2 fill:#9370DB,stroke:#7B68EE,color:#fff
    style L3 fill:#9370DB,stroke:#7B68EE,color:#fff
    
    style result fill:#4ECDC4,stroke:#3DAD9F,color:#000
