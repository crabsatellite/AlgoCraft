%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph rules[" Pattern Rules "]
        R1["'.' matches any single char"]
        R2["'*' matches 0+ of preceding"]
    end
    
    subgraph ex1[" Example: s='aa', p='a*' "]
        E1S["s: a a"]
        E1P["p: a *"]
        E1R["✓ 'a*' = 'aa'"]
    end
    
    subgraph ex2[" Example: s='ab', p='.*' "]
        E2S["s: a b"]
        E2P["p: . *"]
        E2R["✓ '.*' = any string"]
    end
    
    subgraph ex3[" Example: s='aab', p='c*a*b' "]
        E3S["s: a a b"]
        E3P["p: c* a* b"]
        E3R["✓ c*='' a*='aa' b='b'"]
    end
    
    rules --> ex1
    rules --> ex2
    rules --> ex3
    
    style R1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style R2 fill:#FFD700,stroke:#B8860B,color:#000
    
    style E1R fill:#90EE90,stroke:#228B22,color:#000
    style E2R fill:#90EE90,stroke:#228B22,color:#000
    style E3R fill:#90EE90,stroke:#228B22,color:#000
