        direction LR
        C1["1"]
        C2["2"]
        C3["3"]
        C4["6"]
        C5["2"]
        C6["3"]
        C7["4"]
        C8["7"]
        C9["8"]
    end
    
    subgraph groups[" Grouped into 3 consecutive straights "]
        G1["[1, 2, 3]"]
        G2["[2, 3, 4]"]
        G3["[6, 7, 8]"]
    end
    
    C1 --> G1
    C2 --> G1
    C3 --> G1
    
    C5 --> G2
    C6 --> G2
    C7 --> G2
    
    C4 --> G3
    C8 --> G3
    C9 --> G3
    
    result["Output: true ✓"]
