    style G1 fill:#90EE90,stroke:#228B22,color:#000
    style G2 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style G3 fill:#FFD700,stroke:#B8860B,color:#000
    
    style result fill:#4ECDC4,stroke:#3DAD9F,color:#000
