%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph triplets[" triplets "]
        T1["[2, 5, 3]"]
        T2["[1, 8, 4]"]
        T3["[1, 7, 5]"]
    end
    
    subgraph target[" target = [2, 7, 5] "]
        TG["[2, 7, 5]"]
    end
    
    subgraph merge[" Merge T1 and T3 "]
        M1["max(2,1) = 2 ✓"]
        M2["max(5,7) = 7 ✓"]
        M3["max(3,5) = 5 ✓"]
    end
    
    T1 --> merge
    T3 --> merge
    merge --> TG
    
    result["Output: true"]
    TG --> result
    
    style T1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style T2 fill:#333333,stroke:#555555,color:#fff
    style T3 fill:#90EE90,stroke:#228B22,color:#000
    style TG fill:#FFD700,stroke:#B8860B,color:#000
    
    style M1 fill:#9370DB,stroke:#7B68EE,color:#fff
    style M2 fill:#9370DB,stroke:#7B68EE,color:#fff
    style M3 fill:#9370DB,stroke:#7B68EE,color:#fff
    
    style result fill:#4ECDC4,stroke:#3DAD9F,color:#000
