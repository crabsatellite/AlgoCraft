%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph rules[" '*' can be: "]
        R1["'(' left paren"]
        R2["')' right paren"]
        R3["'' empty string"]
    end
    
    subgraph ex1[" s = '(*)' "]
        E1["( * )"]
        E1R["* → '' : valid ✓"]
    end
    
    subgraph ex2[" s = '(*))' "]
        E2["( * ) )"]
        E2R["* → '(' : valid ✓"]
    end
    
    subgraph ex3[" s = '((*)' "]
        E3["( ( * )"]
        E3R["* → ')' : valid ✓"]
    end
    
    rules --> ex1
    rules --> ex2
    rules --> ex3
    
    style R1 fill:#90EE90,stroke:#228B22,color:#000
    style R2 fill:#FF6B6B,stroke:#CC5555,color:#fff
    style R3 fill:#FFD700,stroke:#B8860B,color:#000
    
    style E1R fill:#4ECDC4,stroke:#3DAD9F,color:#000
    style E2R fill:#4ECDC4,stroke:#3DAD9F,color:#000
    style E3R fill:#4ECDC4,stroke:#3DAD9F,color:#000
