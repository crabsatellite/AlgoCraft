%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph before[" Before: intervals = [[1,3],[6,9]] "]
        I1["[1,3]"]
        I2["[6,9]"]
        NEW["new: [2,5]"]
    end
    
    subgraph merge[" Merge Process "]
        M1["[1,3] overlaps [2,5]"]
        M2["Merge → [1,5]"]
        M3["[6,9] no overlap"]
    end
    
    subgraph after[" After: [[1,5],[6,9]] "]
        R1["[1,5]"]
        R2["[6,9]"]
    end
    
    I1 --> M1
    NEW --> M1
    M1 --> M2
    M2 --> R1
    I2 --> M3
    M3 --> R2
    
    style I1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style I2 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style NEW fill:#FFD700,stroke:#B8860B,color:#000
    
    style M2 fill:#9370DB,stroke:#7B68EE,color:#fff
    
    style R1 fill:#90EE90,stroke:#228B22,color:#000
    style R2 fill:#90EE90,stroke:#228B22,color:#000
