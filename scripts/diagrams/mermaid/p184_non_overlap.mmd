%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph input[" intervals = [[1,2],[2,3],[3,4],[1,3]] "]
        I1["[1,2]"]
        I2["[2,3]"]
        I3["[3,4]"]
        I4["[1,3] ❌"]
    end
    
    subgraph analysis[" Overlap Analysis "]
        A1["[1,3] overlaps with [1,2] and [2,3]"]
        A2["Remove [1,3] to fix"]
    end
    
    subgraph result[" Non-overlapping: [[1,2],[2,3],[3,4]] "]
        R1["[1,2]"]
        R2["[2,3]"]
        R3["[3,4]"]
    end
    
    I4 --> A1
    A1 --> A2
    
    I1 --> R1
    I2 --> R2
    I3 --> R3
    
    output["Remove 1 interval"]
    A2 --> output
    
    style I1 fill:#90EE90,stroke:#228B22,color:#000
    style I2 fill:#90EE90,stroke:#228B22,color:#000
    style I3 fill:#90EE90,stroke:#228B22,color:#000
    style I4 fill:#FF6B6B,stroke:#CC5555,color:#fff
    
    style output fill:#FFD700,stroke:#B8860B,color:#000
