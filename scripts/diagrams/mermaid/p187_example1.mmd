%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
gantt
    title Minimum Arrows to Burst Balloons
    dateFormat X
    axisFormat %s
    
    section Balloons
    Balloon [1,6]      :b1, 1, 6
    Balloon [2,8]      :b2, 2, 8
    Balloon [7,12]     :b3, 7, 12
    Balloon [10,16]    :b4, 10, 16
    
    section Arrows
    Arrow at x=6       :milestone, m1, 6, 0
    Arrow at x=11      :milestone, m2, 11, 0
