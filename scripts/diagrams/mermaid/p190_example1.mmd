%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph LR
    subgraph Input["Input Matrix"]
        direction TB
        I0["1 1 1"]
        I1["1 <span style='color:#ff6b6b;font-weight:bold'>0</span> 1"]
        I2["1 1 1"]
    end
    
    subgraph Process["Process"]
        direction TB
        P1["Find 0 at (1,1)"]
        P2["Mark row 1"]
        P3["Mark col 1"]
    end
    
    subgraph Output["Output Matrix"]
        direction TB
        O0["1 <span style='color:#ff6b6b;font-weight:bold'>0</span> 1"]
        O1["<span style='color:#ff6b6b;font-weight:bold'>0 0 0</span>"]
        O2["1 <span style='color:#ff6b6b;font-weight:bold'>0</span> 1"]
    end
    
    Input --> Process
    Process --> Output
    
    style I1 fill:#2d2d2d,stroke:#ff6b6b
    style O1 fill:#2d2d2d,stroke:#ff6b6b
    style O0 fill:#2d2d2d,stroke:#4a90d9
    style O2 fill:#2d2d2d,stroke:#4a90d9
