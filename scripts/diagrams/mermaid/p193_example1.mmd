%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph title["Fast Power: 2^10 = 1024"]
        A["pow(2, 10)"] --> B{"n=10 is even"}
        B --> C["= pow(2, 5)²"]
        C --> D["pow(2, 5)"]
        D --> E{"n=5 is odd"}
        E --> F["= 2 × pow(2, 4)"]
        F --> G["pow(2, 4)"]
        G --> H{"n=4 is even"}
        H --> I["= pow(2, 2)²"]
        I --> J["pow(2, 2)"]
        J --> K{"n=2 is even"}
        K --> L["= pow(2, 1)²"]
        L --> M["pow(2, 1)"]
        M --> N{"n=1 is odd"}
        N --> O["= 2 × pow(2, 0)"]
        O --> P["pow(2, 0) = 1"]
    end
    
    subgraph result["Result Calculation"]
        R1["2^0 = 1"]
        R2["2^1 = 2 × 1 = 2"]
        R3["2^2 = 2² = 4"]
        R4["2^4 = 4² = 16"]
        R5["2^5 = 2 × 16 = 32"]
        R6["2^10 = 32² = 1024"]
        R1 --> R2 --> R3 --> R4 --> R5 --> R6
    end
    
    style A fill:#4a90d9,stroke:#2c5282,color:#fff
    style P fill:#48bb78,stroke:#276749,color:#fff
    style R6 fill:#48bb78,stroke:#276749,color:#fff
