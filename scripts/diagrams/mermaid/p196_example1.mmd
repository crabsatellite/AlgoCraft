%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph input["Input: nums = 4, 1, 2, 1, 2"]
        direction LR
        i0[4] --- i1[1] --- i2[2] --- i3[1] --- i4[2]
    end
    
    subgraph xor["XOR Operation"]
        direction TB
        x1["0 XOR 4 = 4"]
        x2["4 XOR 1 = 5"]
        x3["5 XOR 2 = 7"]
        x4["7 XOR 1 = 6"]
        x5["6 XOR 2 = 4"]
        x1 --> x2 --> x3 --> x4 --> x5
    end
    
    subgraph binary["Binary XOR"]
        b1["4: 100"]
        b2["1: 001"]
        b3["2: 010"]
        b4["1: 001"]
        b5["2: 010"]
        b7["Result: 100 = 4"]
    end
    
    subgraph result["Result: 4"]
        R["Single Number = 4"]
    end
    
    input --> xor
    xor --> binary
    binary --> result
    
    style i0 fill:#48bb78,stroke:#276749,color:#fff
    style i1 fill:#4a90d9,stroke:#2c5282,color:#fff
    style i2 fill:#f6ad55,stroke:#c05621,color:#000
    style i3 fill:#4a90d9,stroke:#2c5282,color:#fff
    style i4 fill:#f6ad55,stroke:#c05621,color:#000
    style R fill:#48bb78,stroke:#276749,color:#fff
