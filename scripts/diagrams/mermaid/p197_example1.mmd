%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph input["Input: n = 11 binary 1011"]
        direction LR
        b3["1"] --- b2["0"] --- b1["1"] --- b0["1"]
    end
    
    subgraph method1["Method 1: Bit Counting"]
        m1a["n = 1011"]
        m1b["n AND 1 = 1, count = 1"]
        m1c["n shift right, n = 101"]
        m1d["n AND 1 = 1, count = 2"]
        m1e["n shift right, n = 10"]
        m1f["n AND 1 = 0, count = 2"]
        m1g["n shift right, n = 1"]
        m1h["n AND 1 = 1, count = 3"]
        m1a --> m1b --> m1c --> m1d --> m1e --> m1f --> m1g --> m1h
    end
    
    subgraph method2["Method 2: n AND n-1 trick"]
        t1["n = 1011"]
        t2["n = 1011 AND 1010 = 1010"]
        t3["n = 1010 AND 1001 = 1000"]
        t4["n = 1000 AND 0111 = 0000"]
        t5["3 iterations = 3 ones"]
        t1 --> t2 --> t3 --> t4 --> t5
    end
    
    subgraph result["Result: 3"]
        R["Hamming Weight = 3"]
    end
    
    input --> method1
    input --> method2
    method1 --> result
    method2 --> result
    
    style b3 fill:#48bb78,stroke:#276749,color:#fff
    style b2 fill:#e53e3e,stroke:#9b2c2c,color:#fff
    style b1 fill:#48bb78,stroke:#276749,color:#fff
    style b0 fill:#48bb78,stroke:#276749,color:#fff
    style R fill:#48bb78,stroke:#276749,color:#fff
