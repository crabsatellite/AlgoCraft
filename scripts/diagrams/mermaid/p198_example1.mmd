%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph title["Counting Bits: n = 5"]
        direction TB
    end
    
    subgraph table["Binary and Bit Count"]
        r0["0 = 0000, 0 bits"]
        r1["1 = 0001, 1 bit"]
        r2["2 = 0010, 1 bit"]
        r3["3 = 0011, 2 bits"]
        r4["4 = 0100, 1 bit"]
        r5["5 = 0101, 2 bits"]
    end
    
    subgraph dp["DP: dp i = dp i div 2 + i mod 2"]
        d0["dp 0 = 0"]
        d1["dp 1 = dp 0 + 1 = 1"]
        d2["dp 2 = dp 1 + 0 = 1"]
        d3["dp 3 = dp 1 + 1 = 2"]
        d4["dp 4 = dp 2 + 0 = 1"]
        d5["dp 5 = dp 2 + 1 = 2"]
        d0 --> d1
        d0 --> d2
        d1 --> d3
        d1 --> d4
        d2 --> d5
    end
    
    subgraph result["Result"]
        direction LR
        a0["0"] --- a1["1"] --- a2["1"] --- a3["2"] --- a4["1"] --- a5["2"]
    end
    
    table --> dp
    dp --> result
    
    style r4 fill:#f6ad55,stroke:#c05621,color:#000
    style a0 fill:#4a90d9,stroke:#2c5282,color:#fff
    style a1 fill:#4a90d9,stroke:#2c5282,color:#fff
    style a2 fill:#4a90d9,stroke:#2c5282,color:#fff
    style a3 fill:#4a90d9,stroke:#2c5282,color:#fff
    style a4 fill:#4a90d9,stroke:#2c5282,color:#fff
    style a5 fill:#4a90d9,stroke:#2c5282,color:#fff
