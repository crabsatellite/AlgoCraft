%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a90d9', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph TD
    subgraph input["Input: nums = 3, 0, 1"]
        direction LR
        i0["3"] --- i1["0"] --- i2["1"]
    end
    
    subgraph method1["Method 1: Sum Formula"]
        s1["Expected sum = n times n+1 div 2 = 6"]
        s2["Actual sum = 3 + 0 + 1 = 4"]
        s3["Missing = 6 - 4 = 2"]
        s1 --> s2 --> s3
    end
    
    subgraph method2["Method 2: XOR"]
        x1["XOR all indices: 0 XOR 1 XOR 2 XOR 3 = 0"]
        x2["XOR all values: 3 XOR 0 XOR 1 = 2"]
        x3["Combined: 0 XOR 2 = 2"]
        x1 --> x2 --> x3
    end
    
    subgraph visual["Visual: Who is Missing"]
        direction LR
        v0["0 yes"]
        v1["1 yes"]
        v2["2 no"]
        v3["3 yes"]
    end
    
    subgraph result["Result: 2"]
        R["Missing Number = 2"]
    end
    
    input --> method1
    input --> method2
    method1 --> visual
    method2 --> visual
    visual --> result
    
    style v0 fill:#48bb78,stroke:#276749,color:#fff
    style v1 fill:#48bb78,stroke:#276749,color:#fff
    style v2 fill:#e53e3e,stroke:#9b2c2c,color:#fff
    style v3 fill:#48bb78,stroke:#276749,color:#fff
    style R fill:#48bb78,stroke:#276749,color:#fff
