%%{init: {"theme": "dark"}}%%
graph LR
    subgraph Array["nums = [1,3,4,2,2]"]
        I0["idx0:1"] --> I1["idx1:3"] --> I2["idx2:4"] --> I3["idx3:2"] --> I4["idx4:2"]
