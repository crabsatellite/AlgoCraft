%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#4a9eff', 'lineColor': '#888888', 'primaryTextColor': '#fff'}}}%%
graph LR
    subgraph DLL["Doubly Linked List (Most Recent -> Least Recent)"]
        direction LR
        HEAD["Head"] <--> K1["key:1<br/>val:1"] <--> K2["key:2<br/>val:2"] <--> TAIL["Tail"]
    end
    subgraph HM["HashMap"]
        direction TB
        H1["1 -> Node"] -.-> K1
        H2["2 -> Node"] -.-> K2
    end

    style HEAD fill:#333333,stroke:#555555,color:#fff
    style TAIL fill:#333333,stroke:#555555,color:#fff
    style K1 fill:#4a9eff,stroke:#2a6ecf,color:#fff
    style K2 fill:#90EE90,stroke:#228B22,color:#000
    style H1 fill:#9370DB,stroke:#7B68EE,color:#fff
    style H2 fill:#9370DB,stroke:#7B68EE,color:#fff
