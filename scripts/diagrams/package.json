{
  "name": "algocraft-diagrams",
  "version": "1.0.0",
  "description": "Mermaid diagram generator for AlgoCraft algorithm problems",
  "main": "generate.js",
  "scripts": {
    "generate": "node generate.js",
    "generate:all": "node generate.js --all",
    "generate:problem": "node generate.js --problem",
    "auto": "node auto_generate.js",
    "update": "node update_problems.js",
    "update:dry": "node update_problems.js --dry",
    "build": "node generate.js && node update_problems.js",
    "watch": "node generate.js --watch",
    "clean": "node generate.js --clean"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^10.6.1",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {},
  "keywords": [
    "mermaid",
    "diagram",
    "algorithm",
    "minecraft"
  ],
  "author": "AlgoCraft Contributors",
  "license": "MIT"
}
